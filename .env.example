# Public deployment: set this to the exact base URL submitted to the grader.
# Example: https://your-service.onrender.com
BASE_URL=https://your-service.example.com

# OpenAI-compatible API. Example values are provider-specific; use your chosen provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-provider-key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=34

# Prefer a persistent PostgreSQL database for hosted deployment.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Local fallback: DATABASE_URL=sqlite:///./invoice_agent.db
DATABASE_URL=sqlite:///./invoice_agent.db
